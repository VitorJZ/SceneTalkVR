  taskDefinitions:
  - scenarioId: restaurant_reservation
    context: The learner is reserving a table at a restaurant by speaking with a
      service staff member.
    goals:
    - state date and time
    - state party size
    - ask about availability
    initialQuestion: Good evening. What date, time, and party size would you like
      to reserve?
    fallbackEnvironmentType: restaurant
    fallbackAvatarRole: barista
    fallbackAvatarGenderPresentation: unknown
    fallbackAvatarAttitude: helpful
