  m_Script: {fileID: 11500000, guid: 78f49d3154d44b544aedbc752a090070, type: 3}
  m_Name: ExperimentQuestionnaireCatalog
  m_EditorClassIdentifier: Assembly-CSharp::SceneTalkVR.Core.QuestionnaireCatalog
  catalogVersion: 1.1-stage5.1
  questionnaires:
  - questionnaireId: formal_condition_v1
    questionnaireVersion: 1.0
    audience: 0
    enabled: 1
    sections:
    - sectionId: role_clarity
      displayNameEnglish: Role Clarity
      displayNameChinese: "\u89D2\u8272\u6E05\u6670\u5EA6"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: role_clarity
        itemId: formal_rc_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: I could clearly understand which agent was giving me feedback.
        promptChinese: "\u6211\u80FD\u6E05\u695A\u7406\u89E3\u662F\u54EA\u4E2A Agent
          \u5728\u7ED9\u6211\u53CD\u9988\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: role_clarity
        itemId: formal_rc_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: I could easily distinguish which content continued the conversation
          and which provided language feedback.
        promptChinese: "\u6211\u80FD\u5F88\u5BB9\u6613\u5206\u6E05\u54EA\u4E9B\u5185\u5BB9\u662F\u5728\u7EE7\u7EED\u4EA4\u6D41\uFF0C\u54EA\u4E9B\u5185\u5BB9\u662F\u5728\u63D0\u4F9B\u8BED\u8A00\u53CD\u9988\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: conversation_continuity
      displayNameEnglish: Conversation Continuity
      displayNameChinese: "\u5BF9\u8BDD\u8FDE\u7EED\u6027"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: conversation_continuity
        itemId: formal_cc_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: After a correction appeared, I could still continue the conversation
          smoothly.
        promptChinese: "\u7EA0\u6B63\u51FA\u73B0\u540E\uFF0C\u6211\u4ECD\u7136\u80FD\u987A\u7545\u5730\u7EE7\u7EED\u5BF9\u8BDD\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: conversation_continuity
        itemId: formal_cc_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: After a correction appeared, I needed time to return to the
          conversation.
        promptChinese: "\u7EA0\u6B63\u51FA\u73B0\u540E\uFF0C\u6211\u9700\u8981\u82B1\u65F6\u95F4\u91CD\u65B0\u56DE\u5230\u5BF9\u8BDD\u4E2D\u3002"
        itemType: 0
        required: 1
        reverseScored: 1
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: conversation_continuity
        itemId: formal_cc_03
        itemVersion: 1.0
        displayOrder: 3
        promptEnglish: After feedback appeared, I still felt that I was in the current
          conversational situation.
        promptChinese: "\u53CD\u9988\u51FA\u73B0\u540E\uFF0C\u6211\u4ECD\u7136\u611F\u89C9\u81EA\u5DF1\u5904\u5728\u5F53\u524D\u7684\u5BF9\u8BDD\u60C5\u5883\u4E2D\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: interest_enjoyment
      displayNameEnglish: Interest / Enjoyment
      displayNameChinese: "\u5174\u8DA3\u4E0E\u6109\u60A6"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: interest_enjoyment
        itemId: formal_ie_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: While doing this VR English speaking practice, I thought about
          how much I enjoyed it.
        promptChinese: "\u5728\u8FDB\u884C\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u65F6\uFF0C\u6211\u4F1A\u60F3\u5230\u81EA\u5DF1\u6709\u591A\u4EAB\u53D7\u8FD9\u4E2A\u8FC7\u7A0B\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: interest_enjoyment
        itemId: formal_ie_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: This VR English speaking practice did not hold my attention.
        promptChinese: "\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u6CA1\u6709\u5438\u5F15\u6211\u7684\u6CE8\u610F\u529B\u3002"
        itemType: 0
        required: 1
        reverseScored: 1
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: interest_enjoyment
        itemId: formal_ie_03
        itemVersion: 1.0
        displayOrder: 3
        promptEnglish: I thought this VR English speaking practice was very interesting.
        promptChinese: "\u6211\u8BA4\u4E3A\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u975E\u5E38\u6709\u8DA3\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: interest_enjoyment
        itemId: formal_ie_04
        itemVersion: 1.0
        displayOrder: 4
        promptEnglish: I enjoyed this VR English speaking practice very much.
        promptChinese: "\u6211\u975E\u5E38\u4EAB\u53D7\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: interest_enjoyment
        itemId: formal_ie_05
        itemVersion: 1.0
        displayOrder: 5
        promptEnglish: Participating in this VR English speaking practice was fun.
        promptChinese: "\u53C2\u4E0E\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u5F88\u6709\u8DA3\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: pressure_tension
      displayNameEnglish: Pressure / Tension
      displayNameChinese: "\u538B\u529B\u4E0E\u7D27\u5F20"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: pressure_tension
        itemId: formal_pt_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: I did not feel nervous at all while doing this VR English
          speaking practice.
        promptChinese: "\u5728\u8FDB\u884C\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u65F6\uFF0C\u6211\u4E00\u70B9\u4E5F\u4E0D\u7D27\u5F20\u3002"
        itemType: 0
        required: 1
        reverseScored: 1
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: pressure_tension
        itemId: formal_pt_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: I felt very tense while doing this VR English speaking practice.
        promptChinese: "\u5728\u8FDB\u884C\u8FD9\u6B21 VR \u82F1\u8BED\u53E3\u8BED\u7EC3\u4E60\u65F6\uFF0C\u6211\u611F\u5230\u975E\u5E38\u7D27\u5F20\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: learning_support
      displayNameEnglish: Learning Support
      displayNameChinese: "\u5B66\u4E60\u652F\u6301"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: learning_support
        itemId: formal_ls_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: I understood what this feedback wanted me to improve.
        promptChinese: "\u6211\u80FD\u7406\u89E3\u8FD9\u6761\u53CD\u9988\u60F3\u8981\u6211\u6539\u8FDB\u4EC0\u4E48\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: learning_support
        itemId: formal_ls_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: I could relate this feedback to what I had just said.
        promptChinese: "\u6211\u80FD\u628A\u8FD9\u6761\u53CD\u9988\u548C\u81EA\u5DF1\u521A\u624D\u7684\u8868\u8FBE\u8054\u7CFB\u8D77\u6765\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: learning_support
        itemId: formal_ls_03
        itemVersion: 1.0
        displayOrder: 3
        promptEnglish: I found the feedback useful for improving my English expression.
        promptChinese: "\u6211\u8BA4\u4E3A\u8FD9\u6761\u53CD\u9988\u6709\u52A9\u4E8E\u6539\u8FDB\u6211\u7684\u82F1\u8BED\u8868\u8FBE\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: learning_support
        itemId: formal_ls_04
        itemVersion: 1.0
        displayOrder: 4
        promptEnglish: This feedback was practical for improving my future English
          conversations.
        promptChinese: "\u8FD9\u6761\u53CD\u9988\u5BF9\u6539\u8FDB\u6211\u4E4B\u540E\u7684\u82F1\u8BED\u5BF9\u8BDD\u5177\u6709\u5B9E\u7528\u4EF7\u503C\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: social_comfort
      displayNameEnglish: Social Comfort
      displayNameChinese: "\u793E\u4EA4\u8212\u9002\u5EA6"
      displayOrder: 0
      items:
      - questionnaireId: formal_condition_v1
        sectionId: social_comfort
        itemId: formal_social_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: "I don\u2019t worry about making mistakes during this VR speaking
          practice."
        promptChinese: "\u5728\u8FD9\u6B21 VR \u53E3\u8BED\u7EC3\u4E60\u4E2D\uFF0C\u6211\u4E0D\u62C5\u5FC3\u72AF\u82F1\u8BED\u9519\u8BEF\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 0
        protocolDecisionDependency: formal_social_comfort
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: social_comfort
        itemId: formal_social_02
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: I am afraid that the feedback provider is ready to correct
          every mistake I make.
        promptChinese: "\u6211\u62C5\u5FC3\u8FD9\u4E2A\u53CD\u9988\u8005\u4F1A\u968F\u65F6\u7EA0\u6B63\u6211\u72AF\u7684\u6BCF\u4E00\u4E2A\u9519\u8BEF\u3002"
        itemType: 0
        required: 1
        reverseScored: 1
        scaleMin: 1
        scaleMax: 7
        enabled: 0
        protocolDecisionDependency: formal_social_comfort
        choiceValues: []
      - questionnaireId: formal_condition_v1
        sectionId: social_comfort
        itemId: formal_social_03
        itemVersion: 1.0
        displayOrder: 3
        promptEnglish: I felt nervous when I had to speak during this session.
        promptChinese: "\u5728\u8FD9\u6B21\u4F1A\u8BDD\u4E2D\u6211\u5FC5\u987B\u53D1\u8A00\u65F6\u611F\u5230\u7D27\u5F20\u3002"
        itemType: 0
        required: 1
        reverseScored: 1
        scaleMin: 1
        scaleMax: 7
        enabled: 0
        protocolDecisionDependency: formal_social_comfort
        choiceValues: []
  - questionnaireId: pilot_condition_v1
    questionnaireVersion: 1.0
    audience: 1
    enabled: 1
    sections:
    - sectionId: role_clarity
      displayNameEnglish: Role Clarity
      displayNameChinese: "\u89D2\u8272\u6E05\u6670\u5EA6"
      displayOrder: 0
      items:
      - questionnaireId: pilot_condition_v1
        sectionId: role_clarity
        itemId: pilot_rc_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: I clearly understood the role of this agent.
        promptChinese: "\u6211\u80FD\u6E05\u695A\u7406\u89E3\u8FD9\u4E2A\u89D2\u8272\u7684\u4F5C\u7528\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: social_comfort
      displayNameEnglish: Social Comfort
      displayNameChinese: "\u793E\u4EA4\u8212\u9002\u5EA6"
      displayOrder: 0
      items:
      - questionnaireId: pilot_condition_v1
        sectionId: social_comfort
        itemId: pilot_sc_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: Receiving feedback from this agent did not make me uncomfortable.
        promptChinese: "\u4ECE\u8FD9\u4E2A\u89D2\u8272\u90A3\u91CC\u6536\u5230\u53CD\u9988\u4E0D\u4F1A\u8BA9\u6211\u4E0D\u5B89\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
    - sectionId: acceptance
      displayNameEnglish: Overall Acceptance
      displayNameChinese: "\u603B\u4F53\u63A5\u53D7\u5EA6"
      displayOrder: 0
      items:
      - questionnaireId: pilot_condition_v1
        sectionId: acceptance
        itemId: pilot_accept_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: Overall, I would accept using this agent form for corrective
          feedback.
        promptChinese: "\u603B\u4F53\u800C\u8A00\uFF0C\u6211\u80FD\u63A5\u53D7\u4F7F\u7528\u8FD9\u79CD
          Agent \u5F62\u6001\u63D0\u4F9B\u7EA0\u9519\u53CD\u9988\u3002"
        itemType: 0
        required: 1
        reverseScored: 0
        scaleMin: 1
        scaleMax: 7
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
  - questionnaireId: formal_final_v1
    questionnaireVersion: 1.0
    audience: 2
    enabled: 1
    sections:
    - sectionId: ranking
      displayNameEnglish: Final Preference Ranking
      displayNameChinese: "\u6700\u7EC8\u504F\u597D\u6392\u5E8F"
      displayOrder: 0
      items:
      - questionnaireId: formal_final_v1
        sectionId: ranking
        itemId: formal_rank_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: Rank NE, NR, SE and SR from most preferred to least preferred.
        promptChinese: "\u8BF7\u5C06 NE\u3001NR\u3001SE\u3001SR \u4ECE\u6700\u5E0C\u671B\u4F7F\u7528\u5230\u6700\u4E0D\u5E0C\u671B\u4F7F\u7528\u6392\u5E8F\u3002"
        itemType: 2
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues:
        - NE
        - NR
        - SE
        - SR
      - questionnaireId: formal_final_v1
        sectionId: ranking
        itemId: formal_rank_reason
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: Please explain your ranking.
        promptChinese: "\u8BF7\u8BF4\u660E\u6392\u5E8F\u7406\u7531\u3002"
        itemType: 4
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
  - questionnaireId: pilot_final_v1
    questionnaireVersion: 1.0
    audience: 3
    enabled: 1
    sections:
    - sectionId: ranking
      displayNameEnglish: Embodiment Ranking
      displayNameChinese: "Agent \u5F62\u6001\u6392\u5E8F"
      displayOrder: 0
      items:
      - questionnaireId: pilot_final_v1
        sectionId: ranking
        itemId: pilot_rank_01
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: Rank the three agent forms from most preferred to least preferred.
        promptChinese: "\u8BF7\u5C06\u4E09\u79CD Agent \u5F62\u6001\u4ECE\u6700\u5E0C\u671B\u4F7F\u7528\u5230\u6700\u4E0D\u5E0C\u671B\u4F7F\u7528\u6392\u5E8F\u3002"
        itemType: 2
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues:
        - voice_only
        - floating_orb
        - humanoid_agent
      - questionnaireId: pilot_final_v1
        sectionId: ranking
        itemId: pilot_rank_reason
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: Which form would you most like to use long term, and why?
        promptChinese: "\u4F60\u6700\u5E0C\u671B\u957F\u671F\u4F7F\u7528\u54EA\u4E00\u79CD\u5F62\u6001\uFF1F\u8BF7\u8BF4\u660E\u7406\u7531\u3002"
        itemType: 4
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
  - questionnaireId: formal_interview_v1
    questionnaireVersion: 1.0
    audience: 4
    enabled: 1
    sections:
    - sectionId: interview
      displayNameEnglish: Structured Interview
      displayNameChinese: "\u7ED3\u6784\u5316\u8BBF\u8C08"
      displayOrder: 0
      items:
      - questionnaireId: formal_interview_v1
        sectionId: interview
        itemId: interview_preference_reason
        itemVersion: 1.0
        displayOrder: 1
        promptEnglish: Why did you prefer this feedback condition?
        promptChinese: "\u4F60\u4E3A\u4EC0\u4E48\u66F4\u504F\u597D\u8FD9\u79CD\u53CD\u9988\u6761\u4EF6\uFF1F"
        itemType: 5
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
      - questionnaireId: formal_interview_v1
        sectionId: interview
        itemId: interview_role_reason
        itemVersion: 1.0
        displayOrder: 2
        promptEnglish: How did you understand the agents' conversational and teaching
          roles?
        promptChinese: "\u4F60\u5982\u4F55\u7406\u89E3 Agent \u7684\u4EA4\u6D41\u8005\u4E0E\u6559\u5E08\u89D2\u8272\uFF1F"
        itemType: 5
        required: 1
        reverseScored: 0
        scaleMin: 0
        scaleMax: 0
        enabled: 1
        protocolDecisionDependency:
        choiceValues: []
