  "example": {
    "participantId": "P-STABLE",
    "seedHash": "e432ad65",
    "mapping": {
      "NE": "gym_membership",
      "NR": "tourist_assistance",
      "SE": "hotel_check_in",
      "SR": "furniture_shopping"
    }
  }
}
