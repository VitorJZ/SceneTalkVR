*.py[cod]

# Local scratch/output artifacts
tmp/
examples/*-bbox-work/

# Unity Android signing keys - keep private, recreate locally when needed
*.keystore
*.jks

# Local SDK download/extract cache; the committed copy lives under Client/Packages
PICO Unity Integration SDK-*/

# Local voice gateway secrets
Server/voice-gateway/voice-gateway.local.json

# Local LLM gateway secrets
Server/llm-gateway/llm-gateway.local.json

# IDE / editor
.vs/
.vscode/
.idea/

# OS metadata
Thumbs.db
Desktop.ini

# Local Env Secrets
.env
.env.local
